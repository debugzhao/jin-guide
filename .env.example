# ============================================================
# 问津 Agent — 环境变量模板
# 复制为 .env 并填入真实值，不要提交 .env 到 git
# ============================================================

# ---- LLM ----
OPENAI_API_KEY=sk-...
# Rerank API，可选，留空则跳过 rerank（不用两段式检索精排也能跑，只是候选排序
# 退化为纯向量相似度）。去 https://dashboard.cohere.com 注册拿 key。
# 注意：留空时不要写成 "KEY=   # 注释" 这种同行内联注释——docker-compose 的
# .env 解析器在"值为空"时不会正确识别行内 # 注释，会把注释文字整段并入取值，
# 污染这个变量（2026-08-24 就是这么踩的坑）。
COHERE_API_KEY=

# ---- LiteLLM Gateway ----
# LiteLLM Proxy 鉴权密钥，生产环境改为随机强密码
LITELLM_MASTER_KEY=sk-wenjin-dev

# ---- 数据库 ----
# PostgreSQL 密码
POSTGRES_PASSWORD=wenjin_dev
# DATABASE_URL 由 docker-compose 自动拼接，本地直连时填此处：
# DATABASE_URL=postgresql+asyncpg://wenjin:wenjin_dev@localhost:5432/wenjin

# ---- Redis ----
# docker-compose 内部自动配置
# REDIS_URL=redis://localhost:6379

# ---- 可观测性 ----
# LangSmith API Key
LANGSMITH_API_KEY=ls__...
# LangSmith 项目名
LANGSMITH_PROJECT=wenjin-agent-dev

# ---- 应用安全 ----
# Session 加密，生产环境必须改为随机 32+ 位字符串
SECRET_KEY=dev-secret-key-32chars-changeme
# 是否向前端展示模型推理；生产环境建议保持关闭
ENABLE_REASONING_DISPLAY=false
# 邮箱注册邀请码，固定 8 位；不设置则用后端默认值
# REGISTER_INVITE_CODE=CFVD6EGQ

# ---- 前端 ----
# 前端访问后端 API 的地址
NEXT_PUBLIC_API_URL=http://localhost:8000

# ---- 环境标识 ----
# development | production
ENV=development
