# ============================================================
# 问津 Agent — 环境变量模板
# 复制为 .env 并填入真实值，不要提交 .env 到 git
# ============================================================

# ---- LLM ----
OPENAI_API_KEY=sk-...
COHERE_API_KEY=                        # Rerank API，可选，留空则跳过 rerank

# ---- LiteLLM Gateway ----
LITELLM_MASTER_KEY=sk-wenjin-dev       # LiteLLM Proxy 鉴权密钥，生产环境改为随机强密码

# ---- 数据库 ----
POSTGRES_PASSWORD=wenjin_dev           # PostgreSQL 密码
# DATABASE_URL 由 docker-compose 自动拼接，本地直连时填此处：
# DATABASE_URL=postgresql+asyncpg://wenjin:wenjin_dev@localhost:5432/wenjin

# ---- Redis ----
# REDIS_URL=redis://localhost:6379     # docker-compose 内部自动配置

# ---- 可观测性 ----
LANGSMITH_API_KEY=ls__...              # LangSmith API Key
LANGSMITH_PROJECT=wenjin-agent-dev    # LangSmith 项目名

# ---- 应用安全 ----
SECRET_KEY=dev-secret-key-32chars-changeme  # Session 加密，生产环境必须改为随机 32+ 位字符串
ENABLE_REASONING_DISPLAY=false              # 是否向前端展示模型推理；生产环境建议保持关闭
# REGISTER_INVITE_CODE=CFVD6EGQ             # 邮箱注册邀请码，固定 8 位；不设置则用后端默认值

# ---- 前端 ----
NEXT_PUBLIC_API_URL=http://localhost:8000   # 前端访问后端 API 的地址

# ---- 环境标识 ----
ENV=development                        # development | production
